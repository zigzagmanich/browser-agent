ANTHROPIC_API_KEY=sk-ant-...

# Модель-оркестратор: принимает решения, держит длинный горизонт.
ORCHESTRATOR_MODEL=claude-sonnet-5
# Модель под-агентов: чтение страниц, классификация, оценка риска.
WORKER_MODEL=claude-haiku-4-5-20251001

# Где хранить persistent-профили браузера (куки, сессии, логины). Одно место
# для агента и стенда probe.py: логин, сделанный руками в стенде, виден агенту.
# По умолчанию ~/.browser-agent/profiles — раскомментируй, чтобы сменить.
# PROFILES_DIR=~/.browser-agent/profiles
# Планировщик: сильная модель один раз задаёт критерии задачи, исполняет ORCHESTRATOR_MODEL.
# Пустое значение выключает планировщик.
PLANNER_MODEL=claude-opus-5
